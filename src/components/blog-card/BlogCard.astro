---
import styles from './BlogCard.module.css'
import Button  from '../ui/button/Button.astro';
import { ArrowRight } from '@lucide/astro';
---

<div class={styles.card}>
    <div class={styles.cardContent}>
         <span class={styles.rating}>9.1</span>

        <div class={styles.restInfo}>
            <span class={styles.title}>Vietnamese Condensed Milk Coffee</span>
            <span class={styles.location}>Katy, Texas</span>
        </div>

        <p class={styles.caption}>An amazing viet coffee with a beautiful presentation. Each sip was sweet, with the coffee flavor boldly hitting in the aftertaste.</p>
    </div>
   

    <div class={styles.blogInfo}>
        <div class={styles.blogInfoDeets}>
            <span class={styles.date}>July 15th 2026</span> 
            <span class={styles.restName}>Madame Mai</span> 
        </div>
         
        <Button variant='outline'>
            See review
            <ArrowRight />
        </Button>
    </div>
</div>