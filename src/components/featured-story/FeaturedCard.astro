---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import { featuredStory } from '../../data/story';
import FeaturedStory from './FeaturedStory';
import Button from '../ui/button/Button';
import styles from './FeaturedCard.module.css';
---

<FeaturedStory story={featuredStory} client:load>
    <div class={styles.card}>
        <div class={styles.media}>
            <Image src={featuredStory.cover} alt={featuredStory.coverAlt} class={styles.image} />
        </div>

        <div class={styles.body}>
            <div class={styles.meta}>
                <div class={styles.info}>
                    <div class={styles.tag}>Featured</div>
                    <span class={styles.readTime}>{featuredStory.topic} · {featuredStory.readTime}</span>
                </div>
                <div class={styles.link}>
                    <Button variant="text">
                        Read the story <ArrowRight size={18} class={styles.arrow} />
                    </Button>
                </div>
            </div>

            <h2 class={styles.title}>{featuredStory.title}</h2>
            <p class={styles.snippet}>{featuredStory.snippet}</p>
        </div>
    </div>
</FeaturedStory>
